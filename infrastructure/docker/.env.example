# ================================================
# GYM-147 Environment Configuration Template
# Copy this file to .env and fill in your values
# ================================================

# ==================== DOMAIN CONFIG ====================
# Your domain names
DOMAIN=localhost
API_DOMAIN=localhost
ADMIN_DOMAIN=localhost

# ==================== PORTS ====================
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443

# ==================== DATABASE (Supabase) ====================
# Supabase Connection String
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.lxkecxnfjjvpjqfideqm.supabase.co:5432/postgres

# ==================== REDIS ====================
# Connection string cho Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=redis_secret

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ==================== EMAIL (SendGrid) ====================
# Get from: https://sendgrid.com
SENDGRID_API_KEY=
FROM_EMAIL=noreply@example.com

# ==================== SMS (Twilio) ====================
# Get from: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==================== AWS S3 (File Storage) ====================
# For storing images, documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=gym147-uploads

# ==================== CLOUDINARY (Image Processing) ====================
# Alternative to S3, optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== VNPay (Vietnam Payment) ====================
# Sandbox: https://sandbox.vnpayment.vn
# Production: https://vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost:8080/billing/vnpay/return

# ==================== MoMo Payment ====================
# Sandbox: https://test-payment.momo.vn
# Production: https://payment.momo.vn
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ==================== FRONTEND URL ====================
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ==================== ENVIRONMENT ====================
NODE_ENV=development
